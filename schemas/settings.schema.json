    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "order": {
