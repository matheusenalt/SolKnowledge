            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "enabled_components": {
            "type": "array",
            "items": {
              "enum": [
                "attachment",
                "cabling",
                "code",
                "command",
                "diagram",
                "equipment",
                "image",
                "personal_note",
                "procedure",
                "reference",
                "table",
                "text",
                "topology",
                "troubleshooting",
                "warning"
